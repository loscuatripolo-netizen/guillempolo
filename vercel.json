{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/og-(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/fuentes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/gsap.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/facturas-a-datos",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/asistente-whatsapp",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/publicaciones-automaticas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/material",
      "destination": "/",
      "permanent": false
    }
  ]
}