{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/og-(.*).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
